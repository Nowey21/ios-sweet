+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* comm interface 0: CDC NCM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM 1.0, no optional requests */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 1: NTB, two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+#define NCM_NTH16_SIG   0x484d434eu     /* "NCMH" */
+#define NCM_NDP16_SIG   0x304d434eu     /* "NCM0" */
+#define NCM_NTB_MAX     UD_FRAME_MAX    /* both directions: one 2 KiB buffer */
+#define NCM_TX_HDR      28u             /* NTH16 12 + NDP16 16 (one datagram) */
+
+static inline uint16_t
+ncm_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static inline void
+ncm_put16(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+}
+
+static inline void
+ncm_put32(uint8_t *p, uint32_t v)
+{
+	ncm_put16(p, v); ncm_put16(p + 2, v >> 16);
+}
