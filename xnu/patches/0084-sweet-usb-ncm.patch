+/* One NCM NTB16: NTH16, then a chain of NDP16s listing the datagrams. */
+static void
+ud_rx_ntb(uint32_t len)
+{
+	const uint8_t *b = (const uint8_t *)(ud.dma + UD_RX);
+	if (len < 12 || (ncm_le16(b) | (uint32_t)ncm_le16(b + 2) << 16) != NCM_NTH16_SIG) {
+		return;
+	}
+	uint32_t block = ncm_le16(b + 8), ndp = ncm_le16(b + 10);
+	if (block > len) {
+		block = len;
+	}
+	for (unsigned hops = 0; ndp && hops < 4; hops++) {
+		if (ndp + 16 > block ||
+		    (ncm_le16(b + ndp) | (uint32_t)ncm_le16(b + ndp + 2) << 16) != NCM_NDP16_SIG) {
+			return;
+		}
+		uint32_t ndp_len = ncm_le16(b + ndp + 4);
+		for (uint32_t e = 8; e + 4 <= ndp_len && ndp + e + 4 <= block; e += 4) {
+			uint32_t off = ncm_le16(b + ndp + e), dlen = ncm_le16(b + ndp + e + 2);
+			if (off == 0 || dlen == 0) {
+				break;
+			}
+			if (off + dlen <= block) {
+				ud_rx_frame(UD_RX + off, dlen);
+			}
+		}
+		ndp = ncm_le16(b + ndp + 6);
+	}
+}
