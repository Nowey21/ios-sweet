 /* T0SZ: 32 (4 GB) for the GMU, 25 (39-bit) for the GPU; walks start at level 1 either way. */
-static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
+/* 0 = the stream match took: davinci's SMMU refuses SMRs that are not the DT's exact stream (reads back 0). */
+static int smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t mask)
 {
 	uint32_t t0sz = sid == GPU_SID ? 25 : 32;
 	uint64_t c = SMMU_CB(cb);
@@ -269,8 +270,11 @@ static void smmu_bank(int smr, int cb, uint64_t ttbr0, uint32_t sid, uint32_t ma
 	wait_bit(SMMU + 0x74, 1, 0, 10);
 	wr32(S2CR(smr), (uint32_t)cb);
 	wr32(SMR(smr), (1u << 31) | (mask << 16) | sid);
-	a6_log("smmu: smr%d %x -> cb%d cbar %x sctlr %x tcr %x tcr2 %x\n", smr, rd32(SMR(smr)), cb,
-	       rd32(CBAR(cb)), rd32(c + CB_SCTLR), rd32(c + CB_TCR), rd32(c + CB_TCR2));
+	uint32_t want = (1u << 31) | (mask << 16) | sid;
+	a6_log("smmu: smr%d %x -> cb%d cbar %x sctlr %x tcr %x tcr2 %x%s\n", smr, rd32(SMR(smr)), cb,
+	       rd32(CBAR(cb)), rd32(c + CB_SCTLR), rd32(c + CB_TCR), rd32(c + CB_TCR2),
+	       rd32(SMR(smr)) == want ? "" : " NOT as written");
+	return rd32(SMR(smr)) == want ? 0 : -1;
 }
 
