+		       rd32(GMU_REG(GMU_G2H_INFO)));
+		return -1;
+	}
 	memset(msg, 0, sizeof(msg));
 	(void)hfi_send(g, 5, msg, 1);	/* TEST: no more HFI until the next boot (Linux ignores the result) */
 
