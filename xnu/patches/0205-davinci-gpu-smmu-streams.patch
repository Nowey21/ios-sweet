 /* a6xx_gmu_rpmh_init for the A640 and A618 (both pdc_address_offset 0x30090). */
@@ -655,6 +658,13 @@ static int gmu_hfi(struct a6_gpu *g)
 	for (unsigned i = 0; i < sizeof(bw) / sizeof(bw[0]); i++)
 		msg[bw[i][0]] = bw[i][1];
 	rc |= hfi_send(g, 3, msg, 32 + 128);
+	if (rc) {
+		uint64_t c = SMMU_CB(g->gmu_cb);
+		a6_log("hfi v1 failed (%d): gmu cb%d fsr %x far %x%08x fsynr0 %x; g2h info %x; not powering the GPU\n",
