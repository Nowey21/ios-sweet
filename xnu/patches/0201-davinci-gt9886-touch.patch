+static int
+touch_gt9886_ack(void)
+{
+	const uint8_t ack[3] = {GT9886_COOR_REG >> 8, GT9886_COOR_REG & 0xffu, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/*
+ * Normandy report at coor: status, touch state (count in the low nibble),
+ * then 8-byte points (id, x LE16, y LE16, width, ...), key and checksum;
+ * the u8 sum of the first 4 + 8n bytes is 0. Status is cleared after every
+ * event, as the vendor IRQ thread does.
+ */
+static int
+touch_gt9886(void)
+{
+	uint8_t buf[GT9886_HEAD_LEN + GOODIX_POINT_LEN * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GT9886_COOR_REG, true, buf,
+	    GT9886_HEAD_LEN + GOODIX_POINT_LEN);
+	if (err) {
+		return err;
+	}
+	if (!buf[0]) {
+		return 0; /* no event: retain current contacts */
+	}
+	if (!(buf[0] & 0x80u)) {
+		(void)touch_gt9886_ack(); /* request/gesture: not serviced */
+		return 0;
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	if (n > 1) {
+		err = touch_read(0x5d, GT9886_COOR_REG + GT9886_HEAD_LEN + GOODIX_POINT_LEN, true,
+		    buf + GT9886_HEAD_LEN + GOODIX_POINT_LEN, (n - 1) * GOODIX_POINT_LEN);
+		if (err) {
+			return err;
+		}
+	}
+	uint8_t sum = 0;
+	for (unsigned i = 0; i < GT9886_HEAD_LEN + n * GOODIX_POINT_LEN; ++i) {
+		sum += buf[i];
+	}
+	if (sum) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2 + i * GOODIX_POINT_LEN;
+		if (p[0] >= 0x80u) {
+			continue; /* pen record */
+		}
+		unsigned id = p[0] & 15u;
+		unsigned px = p[1] | ((unsigned)p[2] << 8), py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > 1079 || py > GT9886_MAX_Y) {
+			(void)touch_gt9886_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_gt9886_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
